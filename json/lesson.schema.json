{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanskritam.example/schemas/lesson.schema.json",
  "title": "Sanskritam 2.0 exported lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["frontmatter", "sections", "vocabulary", "quiz", "registers"],
  "properties": {
    "frontmatter": { "$ref": "frontmatter.schema.json" },
    "sections": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "anchor", "markdown"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 27 },
          "name": { "type": "string" },
          "anchor": { "type": "string" },
          "markdown": { "type": "string" }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deva", "iast", "ipa", "en", "hi", "notes"],
        "properties": {
          "deva": { "type": "string" },
          "iast": { "type": "string" },
          "ipa": { "type": "string" },
          "en": { "type": "string" },
          "hi": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "quiz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions_markdown", "answer_key_markdown"],
      "properties": {
        "questions_markdown": { "type": "string" },
        "answer_key_markdown": { "type": "string" }
      }
    },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "section_index", "text", "refs"],
        "properties": {
          "type": { "type": "string", "enum": ["FACT", "HISTORY", "TRADITION", "SYMBOL"] },
          "section_index": { "type": "integer", "minimum": 1, "maximum": 27 },
          "text": { "type": "string" },
          "refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
